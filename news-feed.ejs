<div class="news-feed__content list">
<% for (const item of items) { %>
<div class="news-teaser news-teaser--feed">
<span class="listing-title" style="display:none;"><%= item.title %></span>
<span class="listing-description" style="display:none;"><%= item.description || '' %></span>
<span class="listing-date" style="display:none;"><%= item.date %></span>
<span class="listing-categories" style="display:none;"><%= (item.categories || []).join(', ') %></span>
<span class="listing-author" style="display:none;"><%= item.author || '' %></span>
<div class="news-teaser__wrapper">
<div class="news-teaser__inner">
<div class="news-teaser__date"><span class="news-teaser__date-text"><%= item.date %></span><% if (item.categories && item.categories.length) { %><span class="news-teaser__cat-sep"></span><span class="news-teaser__date-text"><%= item.categories.join(', ') %></span><% } %></div>
<div class="news-teaser__text">
<h4 class="news-teaser__title"><a href="<%= item.path %>" class="stretched-link"><%= item.title %></a></h4>
<% if (item.description) { %>
<div class="news-teaser__intro"><%= item.description %></div>
<% } %>
</div>
</div>
<% if (item.image) { %>
<div class="news-teaser__image">
<img src="<%= item.image %>" alt="<%= item['image-alt'] || item.title %>">
</div>
<% } %>
</div>
</div>
<% } %>
</div>
