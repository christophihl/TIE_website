<div class="pub-list list">
<% for (const item of items) { %>
<div class="pub-entry pub-entry--<%= item['pub-type'] || 'other' %>">
<span class="listing-title" style="display:none;"><%= item.title %></span>
<span class="listing-description" style="display:none;"><%= item.description || '' %></span>
<span class="listing-date" style="display:none;"><%= item.date %></span>
<span class="listing-categories" style="display:none;"><%= (item.categories || []).join(', ') %></span>
<span class="listing-author" style="display:none;"><%= item.author || '' %></span>
<div class="pub-entry__authors"><%
if (item.authors) {
  try {
    var authors = typeof item.authors === 'string' ? JSON.parse(item.authors) : item.authors;
    if (Array.isArray(authors) && authors.length) {
      for (var ai = 0; ai < authors.length; ai++) {
        if (ai > 0) { %>, <% }
        var a = authors[ai];
        if (a.internal) {
%><a href="/team/<%= a.internal %>/" class="pub-author-link"><strong><%= a.name %></strong></a><%
        } else {
%><%= a.name %><%
        }
      }
    } else { %><%= item.author %><% }
  } catch(e) { %><%= item.author %><% }
} else { %><%= item.author %><% }
%></div>
<div class="pub-entry__title"><a href="<%= item.doi ? 'https://doi.org/' + item.doi : item.path %>"><%= item.title %></a></div>
<div class="pub-entry__venue"><%
if (item['pub-journal']) {
%><em><%= item['pub-journal'] %></em><% if (item.volume) { %>, <%= item.volume %><% } %><% if (item.issue) { %>(<%= item.issue %>)<% } %><% if (item.pages) { %>, <%= item.pages %><% } %><% if (item['article-number']) { %>, <%= item['article-number'] %><% } %><%
} else if (item.conference) {
%><%= item.conference %><% if (item.volume) { %> <%= item.volume %><% } %><% if (item.issue) { %>(<%= item.issue %>)<% } %><% if (item['article-number']) { %>, <%= item['article-number'] %><% } %><% if (item.pages) { %>, <%= item.pages %><% } %><%
} else if (item['book-title']) {
%>In: <% if (item.editors) { %><%= item.editors %>, <% } %><em><%= item['book-title'] %></em><% if (item.series) { %> (<%= item.series %><% if (item.volume) { %>, <%= item.volume %><% } %>)<% } %><% if (item.pages) { %>, <%= item.pages %><% } %><%
} else if (item.institution && item['pub-type'] === 'thesis') {
%>PhD Thesis, <%= item.institution %><%
} else if (item.publisher) {
%><%= item.publisher %><%
} else if (item.institution) {
%><%= item.institution %><%
} else {
%><%= item.description %><%
}
%><% if (item.date) { %> (<%= item.date %>)<% } %></div>
<div class="pub-entry__actions">
<% if (item.doi) { %><a href="https://doi.org/<%= item.doi %>" class="pub-btn pub-btn--doi" target="_blank" rel="noopener">DOI</a><% } %>
<% if (item.tore) { %><a href="<%= item.tore %>" class="pub-btn pub-btn--tore" target="_blank" rel="noopener">TORE</a><% } %>
<% if (item.pdf) { %><a href="<%= item.pdf %>" class="pub-btn pub-btn--pdf" target="_blank" rel="noopener">PDF</a><% } %>
<% if (item.cite) { %><a href="<%= item.cite %>" class="pub-btn pub-btn--cite" download>Cite</a><% } %>
<% if (item.abstract) { %><button class="pub-btn pub-btn--abstract" onclick="this.closest('.pub-entry').querySelector('.pub-entry__abstract').classList.toggle('pub-entry__abstract--open')">Abstract</button><% } %>
<% if (item['pub-links']) { try { var links = typeof item['pub-links'] === 'string' ? JSON.parse(item['pub-links']) : item['pub-links']; if (Array.isArray(links)) { for (var l of links) { %><a href="<%= l.url %>" class="pub-btn pub-btn--link" target="_blank" rel="noopener"><% if (l.icon) { %><i class="<%= l.icon %>"></i> <% } %><%= l.name %></a><% } } } catch(e) {} } %>
<% if (item['pub-status']) { %><span class="pub-status"><%= item['pub-status'] %></span><% } %>
<% if (item.categories && item.categories.length) { %><span class="pub-btn pub-btn--category"><%= item.categories[0] %></span><% } %>
</div>
<% if (item.abstract) { %><div class="pub-entry__abstract"><%= item.abstract %></div><% } %>
<% if (item.extra) { %><div class="pub-entry__extra"><%= item.extra %></div><% } %>
<% if (item.tags && item.tags.length) { %>
<div class="pub-entry__tags">
<% for (const tag of item.tags) { %><span class="pub-tag"><%= tag %></span><% } %>
</div>
<% } %>
</div>
<% } %>
</div>
